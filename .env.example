# ═══════════════════════════════════════════════════════════════════════
# AUREXIS — Environment Configuration Template
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or any file containing real secrets.
# ═══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development          # development | test | production
APP_NAME=AUREXIS
APP_VERSION=0.1.0
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Backend server ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aurexis:change-me-locally@localhost:5432/aurexis
DATABASE_SYNC_URL=postgresql://aurexis:change-me-locally@localhost:5432/aurexis
# For migrations (Alembic uses sync driver)
ALEMBIC_DATABASE_URL=postgresql://aurexis:change-me-locally@localhost:5432/aurexis

# ── Cache / Realtime (Redis) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Application-level encryption key (for sensitive fields)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# ── MT5 Agent ────────────────────────────────────────────────────────────
# The MT5 EA authenticates to this backend.
# Each registered MT5 agent receives a unique ID and secret.
MT5_AGENT_SECRET_KEY=
# Endpoint the backend uses to push commands to MT5 (if push model)
# Leave empty if MT5 polls the backend (pull model — preferred)
MT5_PUSH_ENDPOINT=

# ── Market Data ───────────────────────────────────────────────────────────
# Provider is UNDEFINED until formally specified.
# Populate when a provider is chosen.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
# Staleness threshold is UNDEFINED — leave empty until approved
MARKET_DATA_STALENESS_THRESHOLD_SECONDS=

# ── News Engine ───────────────────────────────────────────────────────────
# Provider is UNDEFINED until formally specified.
NEWS_PROVIDER=
NEWS_API_KEY=
# Pre/post windows are UNDEFINED — leave empty until approved
NEWS_PRE_EVENT_WINDOW_MINUTES=
NEWS_POST_EVENT_WINDOW_MINUTES=

# ── FX Rate (USD → IDR display) ───────────────────────────────────────────
# Provider is UNDEFINED until formally specified.
FX_RATE_PROVIDER=
FX_RATE_API_KEY=

# ── Risk Engine ───────────────────────────────────────────────────────────
# UNDEFINED production values — do NOT set these to invented numbers.
# Leave empty. Risk Engine will report NOT_CONFIGURED for missing required values.
RISK_DAILY_LOSS_LIMIT_USD=
RISK_MAX_DRAWDOWN_USD=
RISK_PROFIT_LOCK_FORMULA=
RISK_MAX_OPEN_POSITIONS=
RISK_DEFAULT_POSITION_SIZE_LOTS=

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

