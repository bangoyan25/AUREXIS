[Unit]
Description=AUREXIS Frontend — Next.js Application (web.aurexis.web.id)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AUREXIS/frontend
ExecStart=/home/ubuntu/AUREXIS/frontend/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aurexis-frontend

# Environment — production API
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=127.0.0.1"
Environment="NEXT_PUBLIC_API_BASE_URL=https://app.aurexis.web.id"
Environment="NEXT_PUBLIC_API_URL=https://app.aurexis.web.id"
Environment="NEXT_PUBLIC_WS_URL=wss://app.aurexis.web.id"
Environment="NEXT_PUBLIC_TRADING_MODE=SIMULATION"

# Process limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
